<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="[%d{HH:mm:ss}] [%t/%INFO] [%logger]: %msg%n"/>
        </Console>
        <File name="TwCinematicFile" fileName="logs/twcinematic.log" append="false">
            <PatternLayout pattern="[%d{yyyy-MM-dd HH:mm:ss}] [%t/%LEVEL] [%logger]: %msg%n"/>
        </File>
    </Appenders>
    <Loggers>
        <Logger name="twcinematic" level="info" additivity="true">
            <AppenderRef ref="TwCinematicFile"/>
        </Logger>
        <Root level="info">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
